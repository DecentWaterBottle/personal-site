---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  image?: string
}

const {
  title,
  description = 'Jack Carter is a software engineer based in Germany, building critical energy infrastructure software and indie games.',
  image = '/og-image.png',
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
const imageUrl = new URL(image, Astro.site)
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="author" content="Jack Carter" />
  <link rel="canonical" href={canonical} />

  <!-- Link previews (LinkedIn, Slack, WhatsApp, X, ...) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Jack Carter" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={imageUrl} />
  {image === '/og-image.png' && <meta property="og:image:width" content="1200" />}
  {image === '/og-image.png' && <meta property="og:image:height" content="630" />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <title>{title}</title>
  <!-- Runs before first paint so dark mode never flashes white between pages -->
  <script is:inline>
    (function () {
      var html = document.documentElement
      html.classList.add('js')
      var saved = null
      try { saved = localStorage.getItem('theme') } catch (e) {}
      if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        html.setAttribute('data-theme', 'dark')
      }
    })()
  </script>
</head>
<body>
  <nav>
    <a href="/" class="wordmark">jack carter</a>
    <a href="/#portfolio">portfolio</a>
    <a href="/#experience">experience</a>
    <a href="/blog">devblog</a>
    <a href="/jack_carter_resume.pdf" target="_blank">resume</a>
    <button class="theme-toggle" id="theme-toggle">dark</button>
  </nav>

  <slot />

  <script>
    const toggle = document.getElementById('theme-toggle')!
    const html = document.documentElement
    if (html.getAttribute('data-theme') === 'dark') toggle.textContent = 'light'

    const revealObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible')
          revealObserver.unobserve(entry.target)
        }
      }
    }, { threshold: 0.1 })
    // Sections already on screen show straight away; only the ones further down fade in on scroll.
    // (Never leave visible content waiting on the observer, e.g. in background tabs.)
    document.querySelectorAll('body > section').forEach((el) => {
      if (el.getBoundingClientRect().top < window.innerHeight) {
        el.style.transition = 'none'
        el.classList.add('is-visible')
      } else {
        revealObserver.observe(el)
      }
    })

    toggle.addEventListener('click', () => {
      const isDark = html.getAttribute('data-theme') === 'dark'
      if (isDark) {
        html.removeAttribute('data-theme')
        localStorage.setItem('theme', 'light')
        toggle.textContent = 'dark'
      } else {
        html.setAttribute('data-theme', 'dark')
        localStorage.setItem('theme', 'dark')
        toggle.textContent = 'light'
      }
    })
  </script>
</body>
</html>
