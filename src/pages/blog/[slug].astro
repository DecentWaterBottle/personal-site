---
import Base from '../../layouts/Base.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
---
<Base title={`${post.data.title} — Jack Carter`}>
  <div class="detail-header">
    <a href="/blog" class="back-link">← devblog</a>
    <h1 style="margin-top:1rem;">{post.data.title}</h1>
    <p class="mono" style="font-size:12px; color:var(--text-tertiary); margin-top:0.4rem;">
      {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
    </p>
  </div>
  {post.data.thumb && <img src={post.data.thumb} alt="" style="width:100%; border-radius:6px; border:1px solid var(--border); margin-bottom:2rem;" />}
  <div class="prose"><Content /></div>
</Base>
