---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---
<Base title="Devblog — Jack Carter">
  <section>
    <p class="section-label">Devblog</p>
    {posts.map(post => (
      <a href={`/blog/${post.id}`} class="blog-row">
        {post.data.thumb && <div class="blog-thumb-wrap"><img class="blog-thumb" src={post.data.thumb} alt="" /></div>}
        <div style="flex:1;">
          <p class="blog-title">{post.data.title}</p>
          <p class="blog-date">{post.data.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}</p>
        </div>
      </a>
    ))}
  </section>
</Base>
