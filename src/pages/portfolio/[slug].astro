---
import Base from '../../layouts/Base.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const portfolio = await getCollection('portfolio')
  return portfolio.map(p => ({ params: { slug: p.id }, props: { item: p } }))
}

const { item } = Astro.props
const { Content } = await render(item)

// SVG thumbs are small card illustrations, not screenshots: skip the banner and link-preview image
const banner = item.data.thumb && !item.data.thumb.endsWith('.svg') ? item.data.thumb : undefined
---
<Base title={`${item.data.title} — Jack Carter`} description={item.data.description} image={banner}>
  <div class="detail-header">
    <a href="/#portfolio" class="back-link">← portfolio</a>
    <h1 style="margin-top:1rem;">
      {item.data.title} <span class={`type-badge ${item.data.type}`}>{item.data.type}</span>
    </h1>
    {item.data.highlight && <p class="highlight" style="margin-top:0.5rem;">★ {item.data.highlight}</p>}
    {item.data.tags && (
      <div class="tags" style="margin-top:0.75rem;">
        {item.data.tags.map((t: string) => <span class="tag">{t}</span>)}
      </div>
    )}
    {item.data.link && (
      <a href={item.data.link} target="_blank" class="more-link" style="margin-top:0.75rem;">
        View project ↗
      </a>
    )}
  </div>
  {banner && (
    <img src={banner} alt="" style="width:100%; border-radius:6px; border:1px solid var(--border); margin-bottom:2rem;" />
  )}
  <div class="prose"><Content /></div>
</Base>
