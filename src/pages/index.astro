---
import Base from '../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { existsSync } from 'node:fs'

// Drop a square photo at public/images/avatar.jpg to replace the monogram
const hasAvatar = existsSync('public/images/avatar.jpg')

const portfolio = (await getCollection('portfolio'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))

const experience = (await getCollection('experience'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))

const volunteering = (await getCollection('volunteering'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
---
<Base title="Jack Carter">

  <section>
    <div class="hero">
      {hasAvatar
        ? <img class="avatar" src="/images/avatar.jpg" alt="Jack Carter" />
        : <div class="avatar avatar-monogram" aria-hidden="true">JC</div>}
      <div>
        <h1>Jack Carter</h1>
        <p class="hero-intro">
          Software engineer based in Germany. Building critical infrastructure and indie games.
        </p>
      </div>
    </div>
    <p class="now">
      <span class="now-dot" aria-hidden="true"></span>
      <span class="now-label">Now</span>
      Full-stack software engineer at Amprion.
    </p>
    <p class="now now-also">
      <span class="now-dot" aria-hidden="true"></span>
      <span class="now-label">Also</span>
      Speaks English and German (professional) · Plays piano
    </p>
    <div class="links">
      <a href="https://github.com/DecentWaterBottle" target="_blank">GitHub ↗</a>
      <a href="https://www.linkedin.com/in/jack-carter4" target="_blank">LinkedIn ↗</a>
      <a href="https://x.com/JEdwardCarter" target="_blank">X ↗</a>
      <a href="/jack_carter_resume.pdf" target="_blank">Resume ↗</a>
      <a href="mailto:jack.carter334@gmail.com">Email ↗</a>
    </div>
  </section>

  <hr />

  <section id="portfolio">
    <p class="section-label">Portfolio</p>
    {portfolio.map(p => (
      <a href={`/portfolio/${p.id}`} style="text-decoration:none; display:block;">
        <div class="card">
          {p.data.thumb
            ? <img class="card-thumb" src={p.data.thumb} alt={p.data.title} />
            : <div class="card-thumb card-thumb-placeholder" aria-hidden="true">{p.data.title.charAt(0)}</div>}
          <div class="card-body">
            <p class="card-title">
              {p.data.title} <span class={`type-badge ${p.data.type}`}>{p.data.type}</span>
            </p>
            {p.data.highlight && <p class="highlight">★ {p.data.highlight}</p>}
            <p class="card-desc">{p.data.description}</p>
            {p.data.tags && (
              <div class="tags">
                {p.data.tags.map((t: string) => <span class="tag">{t}</span>)}
              </div>
            )}
          </div>
        </div>
      </a>
    ))}
  </section>

  <hr />

  <section id="experience">
    <p class="section-label">Professional Employment</p>
    {experience.map(job => (
      <div class="exp-row">
        <div class="exp-dates">{job.data.start} – {job.data.end ?? 'present'}</div>
        <div>
          <div class="exp-head">
            {job.data.logo && <span class="exp-logo"><img src={job.data.logo} alt="" /></span>}
            <div>
              <p class="exp-title">{job.data.company}</p>
              <p class="exp-role">{job.data.role}</p>
            </div>
          </div>
          <p class="exp-desc">{job.data.description}</p>
          {job.data.tags && (
            <div class="tags" style="margin-top:8px;">
              {job.data.tags.map((t: string) => <span class="tag">{t}</span>)}
            </div>
          )}
        </div>
      </div>
    ))}
    {volunteering.length > 0 && (
      <>
        <p class="section-label section-label-sub">Volunteering</p>
        {volunteering.map(v => (
          <div class="exp-row">
            <div class="exp-dates">{v.data.start && <>{v.data.start} – {v.data.end ?? 'present'}</>}</div>
            <div>
              <div class="exp-head">
                {v.data.logo && <span class="exp-logo"><img src={v.data.logo} alt="" /></span>}
                <div>
                  <p class="exp-title">{v.data.organisation}</p>
                  <p class="exp-role">{v.data.role}</p>
                </div>
              </div>
              <p class="exp-desc">{v.data.description}</p>
            </div>
          </div>
        ))}
      </>
    )}
  </section>

  <hr />

  <section>
    <p class="section-label">Devblog</p>
    {posts.map(post => (
      <a href={`/blog/${post.id}`} class="blog-row">
        {post.data.thumb && (
          <div class="blog-thumb-wrap">
            <img class="blog-thumb" src={post.data.thumb} alt="" />
          </div>
        )}
        <div style="flex:1;">
          <p class="blog-title">{post.data.title}</p>
          <p class="blog-date">{post.data.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}</p>
        </div>
      </a>
    ))}
    <a href="/blog" class="more-link">All posts →</a>
  </section>

</Base>
